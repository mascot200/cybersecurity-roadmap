{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOwnUploadsPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::invoices-app-uploads-111122223333/tenants/*"
    },
    {
      "Sid": "UseOnlyTheAppKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:eu-west-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab"
    },
    {
      "Sid": "ReadOnlyTheDbSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-1:111122223333:secret:invoices/db-*"
    }
  ]
}
